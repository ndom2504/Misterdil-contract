{
  "expo": {
    "name": "Misterdil",
    "slug": "misterdil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "misterdil",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ca.misterdil.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "ca.misterdil.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B51CD",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-web-browser",
      "expo-video",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Misterdil utilise vos photos pour votre photo de profil et les pièces jointes des ententes.",
          "cameraPermission": "Misterdil utilise l'appareil photo pour votre photo de profil."
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Misterdil utilise le microphone pour les appels audio avec les parties prenantes.",
          "cameraPermission": "Misterdil utilise l'appareil photo pendant les appels."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://misterdil-contract.vercel.app",
      "router": {},
      "eas": {
        "projectId": "24589834-ad94-4814-a1bd-6133e8875fab"
      }
    },
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "owner": "ndom2504"
  }
}
