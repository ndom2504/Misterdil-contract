generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL is the pooled connection used by the app; DATABASE_URL_UNPOOLED
// is the direct connection Prisma Migrate needs (names match the Neon integration on Vercel).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  phone          String?
  jobTitle       String?
  profileType    String?
  avatarPath     String   @default("")
  onboarded      Boolean  @default(false)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    WorkspaceMember[]
  documents      Document[]        @relation("DocumentCreator")
  moderated      Document[]        @relation("DocumentModerator")
  stakeholders   Stakeholder[]
  comments       Comment[]
  proposals      Proposal[]
  approvals      Approval[]
  notifications  Notification[]
  activities     Activity[]
  aiMessages     AiInteraction[]
  uploads        Attachment[]
  invitationsSent Invitation[] @relation("InvitedBy")
  microsoft      MicrosoftAccount?
  presences      Presence[]
  pushTokens     PushToken[]
  messages       Message[]
  sectionLikes   SectionLike[]
  sectionViews   SectionView[]
  messageReactions MessageReaction[]
  chatClears     ChatClear[]
}

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   @default("")
  chime     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model MicrosoftAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  accessToken  String
  refreshToken String   @default("")
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("ORGANIZATION")
  sector    String?
  address   String   @default("")
  phone     String   @default("")
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  workspaces Workspace[]
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String   @default("")
  sector         String?
  domain         String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  members        WorkspaceMember[]
  documents      Document[]
  attachments    Attachment[]
  activities     Activity[]
  invitations    Invitation[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  createdAt   DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Role {
  id          String       @id
  label       String
  description String
  permissions Permission[]
}

model Permission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  key    String

  @@unique([roleId, key])
}

model DocumentType {
  id          String         @id
  label       String
  description String
  blueprint   String
  active      Boolean        @default(true)
  position    Int            @default(0)
  templates   FormTemplate[]
  documents   Document[]
}

model Document {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  typeId          String
  type            DocumentType @relation(fields: [typeId], references: [id])
  title           String
  sector          String   @default("")
  domain          String   @default("")
  description     String   @default("")
  briefJson       String   @default("")
  briefConfirmed  Boolean  @default(false)
  wizardStep      Int      @default(1)
  status          String   @default("DRAFT")
  color           String   @default("")
  createdById     String
  createdBy       User     @relation("DocumentCreator", fields: [createdById], references: [id])
  moderatorId     String?
  moderator       User?    @relation("DocumentModerator", fields: [moderatorId], references: [id])
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  presences       Presence[]
  sections        DocumentSection[]
  stakeholders    Stakeholder[]
  responses       FormResponse[]
  discussions     Discussion[]
  proposals       Proposal[]
  approvals       Approval[]
  signatures      Signature[]
  versions        DocumentVersion[]
  activities      Activity[]
  attachments     Attachment[]
  aiMessages      AiInteraction[]
  messages        Message[]
  chatClears      ChatClear[]

  @@index([workspaceId])
  @@index([status])
}

// Group chat of an agreement, shared by all its stakeholders. kind is TEXT, FILE (a shared
// file, body is its optional caption) or CALL (a call started in the agreement's audio room).
model Message {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body       String
  kind       String   @default("TEXT")
  fileName   String   @default("")
  fileType   String   @default("")
  fileSize   Int      @default(0)
  filePath   String   @default("")
  createdAt  DateTime @default(now())
  reactions  MessageReaction[]

  @@index([documentId, createdAt])
}

// "Clear for me": the user no longer sees the messages written up to clearedAt.
model ChatClear {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clearedAt  DateTime @default(now())

  @@unique([documentId, userId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model SectionLike {
  id        String          @id @default(cuid())
  sectionId String
  section   DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([sectionId, userId])
}

model SectionView {
  id        String          @id @default(cuid())
  sectionId String
  section   DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt  DateTime        @default(now())

  @@unique([sectionId, userId])
}

model DocumentSection {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  anchor     String
  title      String
  content    String   @default("")
  status     String   @default("NOT_STARTED")
  color      String   @default("")
  position   Int
  updatedAt  DateTime @updatedAt
  updatedById   String?
  updatedByName String   @default("")
  discussions Discussion[]
  proposals  Proposal[]
  approvals  Approval[]
  likes      SectionLike[]
  views      SectionView[]

  @@index([documentId])
}

model FormTemplate {
  id         String      @id @default(cuid())
  typeId     String
  type       DocumentType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  name       String
  fields     FormField[]
}

model FormField {
  id             String       @id @default(cuid())
  templateId     String
  template       FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key            String
  label          String
  help           String       @default("")
  fieldType      String
  required       Boolean      @default(false)
  position       Int
  groupLabel     String
  sectionAnchor  String
  optionsJson    String       @default("")
  sectors        String       @default("")
  excludedSectors String      @default("")
}

model FormResponse {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fieldKey   String
  value      String   @default("")
  updatedAt  DateTime @updatedAt

  @@unique([documentId, fieldKey])
}

model Stakeholder {
  id             String   @id @default(cuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  name           String
  organization   String   @default("")
  partyType      String
  email          String   @default("")
  phone          String   @default("")
  representative String   @default("")
  jobTitle       String   @default("")
  address        String   @default("")
  accessRole     String   @default("PARTICIPANT")
  invitedAt      DateTime?
  createdAt      DateTime @default(now())
  signatures     Signature[]

  @@index([documentId])
  @@index([email])
}

model Discussion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    DocumentSection? @relation(fields: [sectionId], references: [id])
  title      String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  comments   Comment[]

  @@index([documentId])
}

model Comment {
  id           String     @id @default(cuid())
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?      @relation(fields: [authorId], references: [id])
  authorName   String
  body         String
  isAi         Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model Proposal {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sectionId     String
  section       DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?    @relation(fields: [authorId], references: [id])
  authorName    String
  isAi          Boolean  @default(false)
  summary       String   @default("")
  previousText  String
  proposedText  String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?

  @@index([documentId])
}

model Approval {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    DocumentSection? @relation(fields: [sectionId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  roleLabel  String   @default("")
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  decidedAt  DateTime?

  @@index([documentId])
}

model Signature {
  id             String    @id @default(cuid())
  documentId     String
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  stakeholderId  String
  stakeholder    Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  status         String    @default("REQUIRED")
  signerName     String    @default("")
  signerEmail    String    @default("")
  signedAt       DateTime?
  method         String    @default("INTERNAL")
  providerRef    String    @default("")
  createdAt      DateTime  @default(now())

  @@index([documentId])
}

model Attachment {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId   String?
  document     Document? @relation(fields: [documentId], references: [id])
  name         String
  mimeType     String
  size         Int       @default(0)
  storagePath  String    @default("")
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String   @default("")
  href      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id])
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id])
  actorName   String
  kind        String
  message     String
  createdAt   DateTime  @default(now())

  @@index([documentId])
  @@index([workspaceId])
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  label         String
  snapshot      String
  createdByName String
  createdAt     DateTime @default(now())
}

model AiInteraction {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  role       String
  content    String
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String
  documentId  String    @default("")
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  token       String    @unique @default(cuid())
  status      String    @default("PENDING")
  sentAt      DateTime?
  acceptedById String?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model Presence {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sectionId  String?
  lastSeenAt DateTime @default(now())

  @@unique([userId, documentId])
  @@index([documentId, lastSeenAt])
}
